PORT=3000
NODE_ENV=development

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017/yourdbname

# JWT secret key (use a long random string)
JWT_SECRET=your_jwt_secret_here

# Frontend URL for CORS (only needed in production)
FRONTEND_URL=http://localhost:5173

# ImageKit credentials
IMAGEKIT_PUBLICKEY=your_imagekit_public_key
IMAGEKIT_PRIVATEKEY=your_imagekit_private_key
IMAGEKIT_URLENDPOINT=https://ik.imagekit.io/your_imagekit_id
